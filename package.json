{
  "name": "neovim-use-mcp",
  "version": "0.2.1",
  "description": "MCP server that edits files through a real Neovim instance, so agents get LSP, Treesitter and plugins.",
  "type": "module",
  "bin": {
    "neovim-use-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "neovim",
    "lsp",
    "ai-agent",
    "model-context-protocol"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santanusinha/neovim-use-mcp.git"
  },
  "homepage": "https://github.com/santanusinha/neovim-use-mcp#readme",
  "bugs": {
    "url": "https://github.com/santanusinha/neovim-use-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "neovim": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
